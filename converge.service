[Unit]
Description=Python Interface Monitor for CONVERGE
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/SpeedFlux/
EnvironmentFile=/root/SpeedFlux/converge-service.env
ExecStart=/root/SpeedFlux/.venv/bin/python3 main.py --interface ens19 --namespace CONVERGE
Restart=always
StandardOutput=file:/var/log/speedtests/converge_output.log
StandardError=file:/var/log/speedtests/converge_output.log

[Install]
WantedBy=multi-user.target